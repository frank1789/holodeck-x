/*
 * ResultParser.g4
 *
 * It is a grammar file to parser the result file generated by CalculiX (ccx).
 */

// $antlr-format alignTrailingComments true, columnLimit 150, minEmptyLines 1,maxEmptyLinesToKeep 1, reflowComments false, useTab false
// $antlr-format allowShortRulesOnASingleLine false, allowShortBlocksOnASingleLine true, alignSemicolons hanging, alignColons hanging

parser grammar ResultParser;

options {
    tokenVocab = ResultLexer;
}

file
    : line* EOF
    ;

emptyLine
    : NEWLINE
    ;

comment
    : NEWLINE
    | BANG .*? NEWLINE
    ;

node
    : lineIdentifier id = NUMBER x = NUMBER y = NUMBER z = NUMBER comment? NEWLINE
    ;

stress
    : lineIdentifier id = NUMBER sxx = NUMBER syy = NUMBER szz = NUMBER sxy = NUMBER syz = NUMBER szx = NUMBER comment? NEWLINE
    ;

nodeBlockStart
    : START_BLOCK_NODE number_of_node = NUMBER unknown = NUMBER comment? NEWLINE
    ;

lineIdentifier
    : START_BLOCK
    | ELEMENT_BLOCK
    | END_BLOCK
    | COMMAND
    | USER_INFORMATION
    | PARAMETER
    | END_FILE
    ;

line
    : emptyLine
    | comment
    | nodeBlockStart
    | node
    | lineIdentifier comment? NEWLINE
    | stress
    ;
