/*
 * ResultLexer.g4
 *
 * It is a lexer file to parser the result file generated by CalculiX (ccx).
 */

// $antlr-format alignTrailingComments true, columnLimit 150, minEmptyLines 1,maxEmptyLinesToKeep 1, reflowComments false, useTab false
// $antlr-format allowShortRulesOnASingleLine false, allowShortBlocksOnASingleLine true, alignSemicolons hanging, alignColons hanging

lexer grammar ResultLexer;

/* Define the rules for the grammar */
BANG
    : '!'
    ;

START_BLOCK
    : '-1'
    ;

ELEMENT_BLOCK
    : '-2'
    ;

END_BLOCK
    : '-3'
    ;

END_FILE
    : '9999'
    ;

START_BLOCK_NODE
    : '2C'
    ;

fragment COMMAND
    : NUMBER 'C'
    ;

USER_INFORMATION
    : NUMBER 'U'
    ;

PARAMETER
    : NUMBER 'P'
    ;

/* Define token types */
NEWLINE
    : '\n'
    | '\r\n'
    ;

WHITESPACE
    : [ \t]+ -> channel(HIDDEN)
    ;

NUMBER
    : [+-]? (DIGIT+ ('.' DIGIT*)? EXPONENT? | '.' DIGIT+ EXPONENT?)
    ;

// Fragments (Internal helper rules - cannot be matched as standalone tokens)
fragment EXPONENT
    : [eE][+-]? DIGIT+
    ;

fragment DIGIT
    : [0 - 9]
    ;
