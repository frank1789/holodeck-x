root=true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c, cc, cpp, cxx, h, hh, hpp, hxx, ipp, tpp}]
indent_size = 2
max_line_length = 80

[*.{md, markdown}]
trim_trailing_whitespace = false

[*.{yml, yaml}]
indent_size = 2

[*.{json, jsonc}]
indent_size = 2

[*.py]
indent_size = 4
trim_trailing_whitespace = true

[*.rs]
indent_size = 4
max_line_length = 100
