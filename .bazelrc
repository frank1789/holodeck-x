common --enable_platform_specific_config


# enforce C++ standard
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Wpedantic

# --- Specific configuration for macos ---
build:macos --macos_minimum_os=13.0

# --- Address Sanitizer (ASAN) Configuration ---
# Detects memory leaks, out-of-bounds access, use-after-free, etc.
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address

# --- Undefined Behavior Sanitizer (UBSAN) Configuration ---
# Detects signed integer overflow, misaligned pointers, null pointer dereferences, etc.
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --linkopt=-fsanitize=undefined

# Combining ASAN and UBSAN is perfectly safe
build:asan-ubsan --config=asan
build:asan-ubsan --config=ubsan
